# Claude Code
.claude/settings.local.json
.claude/tmp/

# Codex project-local MCP registration — machine-specific absolute paths,
# written by scripts/adopt.sh.
.codex/config.toml

# OS
.DS_Store
Thumbs.db

# Plan scratch: /project:work saves the planner's report here and deletes it
# when the cycle ends. Only `<slug>-plan.md` matches — a suffixed name
# (`auth-plan-v2.md`) shows up as untracked and fails the clean-tree check.
.handoff/*-plan.md

# Worker worktrees prepared by the workflow MCP — throwaway checkouts, never committed.
.worktrees/

# Node dependencies (tools/workflow-mcp).
node_modules/

# Obsidian per-user vault config
docs/.obsidian/

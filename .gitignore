# Scratch — this template has no handoff files (no planner, no adversary),
# but a builder may leave transient working files here. Nothing under
# .claude/scratch/ is a record; the record is the wiki and the commit.
.claude/scratch/

# Local prototype state — the data a demo produced. Regenerate it, don't
# commit it: a demonstration is reproducible or it isn't a demonstration.
*.db
*.sqlite
*.sqlite3
.env

# Obsidian per-user vault config (users open the vault themselves)
docs/.obsidian/

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/.handoff/**)",
      "Edit(/docs/wiki/**)",
      "Edit(/docs/raw/research/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git rev-parse*)"
    ]
  },
  "enabledPlugins": {
    "conductor-guard@claude-code-template": true
  },
  "extraKnownMarketplaces": {
    "claude-code-template": {
      "source": {
        "source": "github",
        "repo": "dagarre00/claude-code-template",
        "ref": "develop"
      },
      "autoUpdate": true
    }
  }
}
